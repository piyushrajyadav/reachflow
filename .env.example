NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://reachflow:reachflow_dev_password@localhost:5432/reachflow?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_URL=http://localhost:9200

# Throughput controls
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_GLOBAL=1000
# Set false to run the worker as a separate process: npm run worker --workspace=@reachflow/api
RUN_WORKER_IN_API=true

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=reachflow_token
COOKIE_SECURE=false

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, type Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth (api.slack.com/apps -> OAuth & Permissions)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_BOT_SCOPES=chat:write

# Default sender (create one free at https://ethereal.email/create)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: comma separated emails allowed on /admin/queues (empty = any signed-in user)
BULL_BOARD_ADMINS=

# 32 bytes hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
