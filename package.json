{
  "name": "reachflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@reachflow/api\" \"npm run dev --workspace=@reachflow/web\"",
    "dev:api": "npm run dev --workspace=@reachflow/api",
    "dev:web": "npm run dev --workspace=@reachflow/web",
    "build": "npm run build --workspace=@reachflow/api && npm run build --workspace=@reachflow/web",
    "typecheck": "npm run typecheck --workspace=@reachflow/api && npm run typecheck --workspace=@reachflow/web",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "test": "npm run test --workspace=@reachflow/api",
    "worker": "npm run worker --workspace=@reachflow/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.0"
  }
}
